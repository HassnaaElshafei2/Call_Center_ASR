# Copy to .env (never commit .env). For local development without Docker, put it in backend/.env.

# --- secrets: set your own -------------------------------------------------------------
# key for the DGX gateway (Open WebUI)
LLM_API_KEY=
# long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# another long random string; changing it later breaks phone matching
PHONE_HASH_KEY=
ADMIN_EMAIL=admin@trysia.ai
# first administrator, created on an empty database
ADMIN_PASSWORD=
# password of the demo users (manager@demo.sia, qa@demo.sia, ...)
DEMO_PASSWORD=
POSTGRES_PASSWORD=callintel-local

# --- models on the DGX gateway ----------------------------------------------------------
LLM_API_URL=https://llm-api.gcp.trysia.ai/api
LLM_MODEL=qwen3.6-35b
# empty = a second Qwen pass; e.g. gemma4-26b once the gateway offers it
LLM_SECOND_OPINION_MODEL=
EMBEDDING_MODEL=qwen3-embedding-4b

# --- transcription service (asr_service/) -----------------------------------------------
# Empty: uploaded recordings wait as "waiting for transcription" until a service is set.
# docker compose --profile asr: http://asr:9000 ; on the DGX later: its URL.
ASR_SERVICE_URL=
# Mohammed's fine-tuned model folder (for the asr profile)
ASR_MODEL_DIR=./model
# optional: pyannote speaker diarization for mono recordings
HF_TOKEN=

# --- worker ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
